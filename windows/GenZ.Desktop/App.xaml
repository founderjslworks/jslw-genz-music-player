<Application x:Class="GenZ.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- Default (GEN-Z Vivid) – replaced live by ThemeManager.Apply -->
        <SolidColorBrush x:Key="BgBrush" Color="#0B0A16" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#16142B" />
        <SolidColorBrush x:Key="SurfaceSoftBrush" Color="#C816142B" />
        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#7B2FF7" Offset="0" />
            <GradientStop Color="#F107A3" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="HeaderTextBrush" Color="White" />
        <SolidColorBrush x:Key="TextBrush" Color="#F7F5FF" />
        <SolidColorBrush x:Key="Text2Brush" Color="#B2ACD6" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF3D9A" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#2EFF3D9A" />
        <SolidColorBrush x:Key="OnAccentBrush" Color="White" />
        <SolidColorBrush x:Key="DividerBrush" Color="#272449" />
        <SolidColorBrush x:Key="RowHlBrush" Color="#7B2FF7" />
        <SolidColorBrush x:Key="RowHlTextBrush" Color="White" />
        <SolidColorBrush x:Key="HoverBrush" Color="#12FFFFFF" />
        <SolidColorBrush x:Key="NpBrush" Color="#2A0E5C" />
        <SolidColorBrush x:Key="NpTextBrush" Color="White" />
        <SolidColorBrush x:Key="NpText2Brush" Color="#C9C3EE" />
        <SolidColorBrush x:Key="LcdBrush" Color="Black" />
        <SolidColorBrush x:Key="LcdTextBrush" Color="#00F5D4" />
        <SolidColorBrush x:Key="ProgressBrush" Color="#FF3D9A" />
        <Color x:Key="AccentColor">#FF3D9A</Color>
        <FontFamily x:Key="BodyFont">Segoe UI</FontFamily>
        <FontFamily x:Key="DisplayFont">Segoe UI</FontFamily>
        <FontFamily x:Key="LcdFont">Consolas</FontFamily>
        <CornerRadius x:Key="Corner">14</CornerRadius>

