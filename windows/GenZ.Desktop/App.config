<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <!-- Per-monitor DPI (Windows 10 1607+): GEN-Z redraws itself sharply at the exact scale of every monitor,
         including 4K at 150–300 %, instead of letting Windows stretch a bitmap. -->
    <AppContextSwitchOverrides value="Switch.System.Windows.DoNotScaleForDpiChanges=false" />
  </runtime>
</configuration>
