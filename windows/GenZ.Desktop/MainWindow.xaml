<Window x:Class="GenZ.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:GenZ.Controls"
        Title="GEN-Z Music" Width="1300" Height="800" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource BgBrush}"
        FontFamily="{DynamicResource BodyFont}" Icon="Assets/genz.png"
        WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True" AllowDrop="True" Drop="OnWindowDrop" DragOver="OnWindowDragOver">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="Taskbar" Description="GEN-Z Music">
            <TaskbarItemInfo.ThumbButtonInfos>
                <ThumbButtonInfo x:Name="TbPrev" Description="Previous" Click="OnPrev" />
                <ThumbButtonInfo x:Name="TbPlay" Description="Play / Pause" Click="OnPlay" />
                <ThumbButtonInfo x:Name="TbNext" Description="Next" Click="OnNext" />
            </TaskbarItemInfo.ThumbButtonInfos>
        </TaskbarItemInfo>
    </Window.TaskbarItemInfo>

    <Window.Resources>
        <!-- song rows: List, Compact, With covers, Details -->
        <DataTemplate x:Key="SongRowList">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="64" />
                </Grid.ColumnDefinitions>
                <Path x:Name="ic" Data="{StaticResource IcNote}" Fill="{DynamicResource Text2Brush}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Left" />
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock x:Name="title" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Artist}" FontSize="12" Foreground="{DynamicResource Text2Brush}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Album}" FontSize="12.5" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="3" Text="{Binding DurationText}" FontSize="12.5" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                        <Setter TargetName="ic" Property="Data" Value="{StaticResource IcEq}" />
                        <Setter TargetName="ic" Property="Fill" Value="{DynamicResource AccentBrush}" />
                        <Setter TargetName="title" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="SongRowCompact">
            <Grid Margin="0,-3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="56" />
                </Grid.ColumnDefinitions>
                <Path x:Name="ic" Data="{StaticResource IcNote}" Fill="{DynamicResource Text2Brush}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <TextBlock x:Name="title" Grid.Column="1" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Artist}" FontSize="12.5" Foreground="{DynamicResource Text2Brush}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding DurationText}" FontSize="12" Foreground="{DynamicResource Text2Brush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                        <Setter TargetName="ic" Property="Data" Value="{StaticResource IcEq}" />
                        <Setter TargetName="ic" Property="Fill" Value="{DynamicResource AccentBrush}" />
                        <Setter TargetName="title" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="SongRowCovers">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="64" />
                </Grid.ColumnDefinitions>
                <Border Width="44" Height="44" CornerRadius="8" HorizontalAlignment="Left" Background="{DynamicResource SurfaceBrush}" c:CoverLoader.Song="{Binding}" />
                <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Path x:Name="ic" Data="{x:Null}" Fill="{DynamicResource AccentBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                        <TextBlock x:Name="title" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Text="{Binding Artist}" FontSize="12" Foreground="{DynamicResource Text2Brush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Album}" FontSize="12.5" Foreground="{DynamicResource Text2Brush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ShortFormat}" FontSize="11" Foreground="{DynamicResource Text2Brush}" Opacity="0.75" Margin="0,2,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="3" Text="{Binding DurationText}" FontSize="12.5" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                        <Setter TargetName="ic" Property="Data" Value="{StaticResource IcEq}" />
                        <Setter TargetName="ic" Property="Fill" Value="{DynamicResource AccentBrush}" />
                        <Setter TargetName="title" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="SongRowDetails">
            <Grid Margin="0,-2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="56" />
                </Grid.ColumnDefinitions>
                <Path x:Name="ic" Data="{StaticResource IcNote}" Fill="{DynamicResource Text2Brush}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <TextBlock x:Name="title" Grid.Column="1" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Artist}" FontSize="12.5" Foreground="{DynamicResource Text2Brush}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding Album}" FontSize="12.5" Foreground="{DynamicResource Text2Brush}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="{Binding Genre}" FontSize="12.5" Foreground="{DynamicResource Text2Brush}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="5" Text="{Binding YearText}" FontSize="12.5" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="6" Text="{Binding PlaysText}" FontSize="12.5" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="7" Text="{Binding ShortFormat}" FontSize="12" Foreground="{DynamicResource Text2Brush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="8" Text="{Binding DurationText}" FontSize="12.5" Foreground="{DynamicResource Text2Brush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                        <Setter TargetName="ic" Property="Data" Value="{StaticResource IcEq}" />
                        <Setter TargetName="ic" Property="Fill" Value="{DynamicResource AccentBrush}" />
                        <Setter TargetName="title" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="92" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ title bar ============ -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="9" Background="Black">
                        <Image Source="Assets/logo.png" Margin="2" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock Text="GEN-Z Music" Margin="12,0,0,0" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"
                               Foreground="{DynamicResource HeaderTextBrush}" FontFamily="{DynamicResource DisplayFont}" />
                </StackPanel>
                <Grid Grid.Column="1" Width="420" Height="36" HorizontalAlignment="Left" Margin="10,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" TextChanged="OnSearch" />
                    <Path Data="{StaticResource IcSearch}" Fill="{DynamicResource HeaderIconBrush}" Width="16" Height="16" Stretch="Uniform"
                          HorizontalAlignment="Left" Margin="14,0,0,0" IsHitTestVisible="False" />
                    <TextBlock x:Name="SearchHint" Text="Search songs, artists, albums" Margin="38,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource HeaderTextBrush}" Opacity="0.7" IsHitTestVisible="False" FontSize="13" />
                </Grid>
                <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Border x:Name="SleepChip" CornerRadius="12" Padding="10,3" Margin="0,0,4,0" VerticalAlignment="Center" Background="#33FFFFFF" Visibility="Collapsed">
                        <TextBlock x:Name="SleepText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource HeaderTextBrush}" />
                    </Border>
                    <Button x:Name="SleepBtn" Style="{StaticResource TitleButton}" Tag="{StaticResource IcMoon}" Click="OnSleep" ToolTip="Sleep timer" />
                    <Button Style="{StaticResource TitleButton}" Tag="{StaticResource IcPip}" Click="OnPip" ToolTip="Mini player – picture in picture (Ctrl+P)" />
                    <Button Style="{StaticResource TitleButton}" Tag="{StaticResource IcPanel}" Click="OnTogglePanel" ToolTip="Show / hide Now Playing" />
                    <Border Width="1" Height="22" Margin="8,0" Background="{DynamicResource HeaderHoverBrush}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource TitleButton}" Tag="{StaticResource IcMin}" Click="OnMin" ToolTip="Minimize" />
                    <Button x:Name="MaxBtn" Style="{StaticResource TitleButton}" Tag="{StaticResource IcMax}" Click="OnMax" ToolTip="Maximize" />
                    <Button Style="{StaticResource TitleCloseButton}" Tag="{StaticResource IcClose}" Click="OnClose" ToolTip="Close" Margin="2,0,8,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ content ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="NpColumn" Width="380" />
            </Grid.ColumnDefinitions>

            <!-- navigation -->
            <Border Background="{DynamicResource SurfaceBrush}">
                <DockPanel Margin="0,14,0,10">
                    <StackPanel DockPanel.Dock="Bottom" Margin="20,0,20,6">
                        <Button Style="{StaticResource GhostPill}" Content="+  Add music folder" Click="OnAddFolder" HorizontalAlignment="Stretch" />
                        <TextBlock x:Name="ScanText" Margin="4,10,0,0" FontSize="11" Foreground="{DynamicResource Text2Brush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="NavPanel">
                        <TextBlock Text="LIBRARY" Margin="26,6,0,6" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Text2Brush}" />
                        <RadioButton x:Name="NavSongs" Style="{StaticResource NavItem}" Content="Songs" Tag="{StaticResource IcNote}" Checked="OnNav" />
                        <RadioButton x:Name="NavAlbums" Style="{StaticResource NavItem}" Content="Albums" Tag="{StaticResource IcAlbum}" Checked="OnNav" />
                        <RadioButton x:Name="NavArtists" Style="{StaticResource NavItem}" Content="Artists" Tag="{StaticResource IcPerson}" Checked="OnNav" />
                        <RadioButton x:Name="NavGenres" Style="{StaticResource NavItem}" Content="Genres" Tag="{StaticResource IcGenre}" Checked="OnNav" />
                        <RadioButton x:Name="NavFolders" Style="{StaticResource NavItem}" Content="Folders" Tag="{StaticResource IcFolder}" Checked="OnNav" />
                        <TextBlock Text="YOUR MUSIC" Margin="26,16,0,6" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Text2Brush}" />
                        <RadioButton x:Name="NavFav" Style="{StaticResource NavItem}" Content="Favourites" Tag="{StaticResource IcHeart}" Checked="OnNav" />
                        <RadioButton x:Name="NavRecent" Style="{StaticResource NavItem}" Content="Recently played" Tag="{StaticResource IcHistory}" Checked="OnNav" />
                        <RadioButton x:Name="NavMost" Style="{StaticResource NavItem}" Content="Most played" Tag="{StaticResource IcFire}" Checked="OnNav" />
                        <RadioButton x:Name="NavQueue" Style="{StaticResource NavItem}" Content="Up next" Tag="{StaticResource IcQueue}" Checked="OnNav" />
                        <Grid Margin="26,16,14,6">
                            <TextBlock Text="PLAYLISTS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource IconButton}" Tag="{StaticResource IcImport}" Width="28" Height="28" Click="OnImportPlaylist" ToolTip="Import a playlist (M3U / M3U8)" />
                                <Button Style="{StaticResource IconButton}" Tag="{StaticResource IcAdd}" Width="28" Height="28" Click="OnNewPlaylist" ToolTip="New playlist" />
                            </StackPanel>
                        </Grid>
                        <StackPanel x:Name="NavPlaylists" />
                        <TextBlock x:Name="NoPlaylists" Text="Right-click songs › Add to playlist, or press +" Margin="26,0,14,4" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Text2Brush}" Opacity="0.8" />
                        <TextBlock Text="EXTRAS" Margin="26,16,0,6" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Text2Brush}" />
                        <RadioButton x:Name="NavThemes" Style="{StaticResource NavItem}" Content="Themes" Tag="{StaticResource IcPalette}" Checked="OnNav" />
                        <RadioButton x:Name="NavAnim" Style="{StaticResource NavItem}" Content="Animations" Tag="{StaticResource IcSpark}" Checked="OnNav" />
                        <RadioButton x:Name="NavEq" Style="{StaticResource NavItem}" Content="Equalizer" Tag="{StaticResource IcEq}" Checked="OnNav" />
                        <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" Content="Settings &amp; About" Tag="{StaticResource IcSettings}" Checked="OnNav" />
                    </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- pages -->
            <Grid Grid.Column="1" x:Name="Pages" Margin="0,0,0,0">
                <!-- song list (songs, favourites, queue, search, album / artist details) -->
                <DockPanel x:Name="PageList">
                    <Grid DockPanel.Dock="Top" Margin="28,22,28,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BackBtn" Style="{StaticResource IconButton}" Tag="{StaticResource IcBack}" Click="OnBack" ToolTip="Back (Alt+←)" Margin="-10,0,8,0" Visibility="Collapsed" />
                            <Border x:Name="ListCover" Width="96" Height="96" CornerRadius="14" Margin="0,0,20,0" Visibility="Collapsed" Background="{DynamicResource SurfaceBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="ListTitle" Text="Songs" FontSize="30" FontWeight="Bold" FontFamily="{DynamicResource DisplayFont}" />
                            <TextBlock x:Name="ListSub" Margin="0,2,0,0" FontSize="13" Foreground="{DynamicResource Text2Brush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource PillButton}" Click="OnPlayAll" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IcPlay}" Fill="{DynamicResource OnAccentBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" /><TextBlock Text="Play" Foreground="{DynamicResource OnAccentBrush}" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostPill}" Click="OnShuffleAll">
                                <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IcShuffle}" Fill="{DynamicResource AccentBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" /><TextBlock Text="Shuffle" Foreground="{DynamicResource AccentBrush}" /></StackPanel>
                            </Button>
                            <Button x:Name="ListMore" Style="{StaticResource IconButton}" Tag="{StaticResource IcMore}" Margin="6,0,0,0" Click="OnListMore" ToolTip="More" Visibility="Collapsed" />
                        </StackPanel>
                        <StackPanel x:Name="ListTools" Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0" />
                    </Grid>
                    <Grid x:Name="ListHeader" DockPanel.Dock="Top" Margin="34,0,42,4" Visibility="Collapsed" />
                    <ListBox x:Name="SongList" ItemTemplate="{StaticResource SongRowList}" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource RowItem}"
                             VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="OnSongDoubleClick" PreviewMouseLeftButtonUp="OnSongClick" KeyDown="OnSongKey" Margin="16,0,8,0"
                             SelectionMode="Extended" ContextMenuOpening="OnSongMenu" PreviewMouseLeftButtonDown="OnRowDown" PreviewMouseMove="OnRowMove"
                             AllowDrop="True" DragOver="OnListDragOver" Drop="OnListDrop" DragLeave="OnListDragLeave">
                    </ListBox>
                </DockPanel>

                <TextBlock x:Name="ListEmpty" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,120,40,0" TextAlignment="Center"
                           FontSize="14" Foreground="{DynamicResource Text2Brush}" TextWrapping="Wrap" MaxWidth="420" IsHitTestVisible="False" />

                <!-- album / artist / theme grids -->
                <DockPanel x:Name="PageGrid" Visibility="Collapsed">
                    <Grid DockPanel.Dock="Top" Margin="28,22,28,12">
                        <StackPanel>
                            <TextBlock x:Name="GridTitle" Text="Albums" FontSize="30" FontWeight="Bold" FontFamily="{DynamicResource DisplayFont}" />
                            <TextBlock x:Name="GridSub" Margin="0,2,0,0" FontSize="13" Foreground="{DynamicResource Text2Brush}" />
                        </StackPanel>
                        <StackPanel x:Name="GridTools" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid x:Name="GridHeader" DockPanel.Dock="Top" Margin="40,0,36,4" Visibility="Collapsed" />
                    <ScrollViewer x:Name="GridScroll" VerticalScrollBarVisibility="Auto" Margin="18,0,8,0">
                        <StackPanel>
                            <WrapPanel x:Name="GridPanel" Margin="0,0,0,20" />
                            <StackPanel x:Name="GridRows" Margin="4,0,10,20" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <!-- equalizer -->
                <ScrollViewer x:Name="PageEq" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,22,28,20">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Equalizer" FontSize="30" FontWeight="Bold" FontFamily="{DynamicResource DisplayFont}" />
                                <TextBlock Text="10-band graphic equalizer with automatic headroom – boosts never clip." Margin="0,2,0,0" FontSize="13" Foreground="{DynamicResource Text2Brush}" />
                            </StackPanel>
                            <CheckBox x:Name="EqOn" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="OnEqToggle" Unchecked="OnEqToggle" Cursor="Hand">
                                <CheckBox.Template>
                                    <ControlTemplate TargetType="CheckBox">
                                        <Border x:Name="sw" Width="52" Height="28" CornerRadius="14" Background="{DynamicResource DividerBrush}">
                                            <Ellipse x:Name="dot" Width="22" Height="22" Fill="White" HorizontalAlignment="Left" Margin="3,0" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="sw" Property="Background" Value="{DynamicResource HeaderBrush}" />
                                                <Setter TargetName="dot" Property="HorizontalAlignment" Value="Right" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </CheckBox.Template>
                            </CheckBox>
                        </Grid>
                        <WrapPanel x:Name="EqPresets" Margin="0,18,0,8" />
                        <Border CornerRadius="18" Background="{DynamicResource SurfaceBrush}" Padding="20,18" Margin="0,8,0,0">
                            <Grid x:Name="EqBands" Height="300" />
                        </Border>
                        <TextBlock Text="Tip: GEN-Z lowers the input as you boost, so loud songs never crackle." Margin="4,14,0,0" FontSize="12" Foreground="{DynamicResource Text2Brush}" />
                    </StackPanel>
                </ScrollViewer>

                <!-- animations -->
                <ScrollViewer x:Name="PageAnim" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="AnimPanel" Margin="28,22,28,20" MaxWidth="760" HorizontalAlignment="Left" />
                </ScrollViewer>

                <!-- settings & about -->
                <ScrollViewer x:Name="PageAbout" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,22,28,20" MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="Settings &amp; About" FontSize="30" FontWeight="Bold" FontFamily="{DynamicResource DisplayFont}" />
                        <StackPanel x:Name="PrefsPanel" />
                        <TextBlock Text="MUSIC FOLDERS" Margin="0,22,0,8" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                        <StackPanel x:Name="FolderList" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource PillButton}" Content="+  Add folder" Click="OnAddFolder" Margin="0,0,10,0" />
                            <Button Style="{StaticResource GhostPill}" Content="Rescan library" Click="OnRescan" />
                        </StackPanel>

                        <TextBlock Text="ABOUT" Margin="0,28,0,10" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                        <Border CornerRadius="18" Background="{DynamicResource SurfaceBrush}" Padding="22">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="96" Height="96" CornerRadius="20" Background="White" Padding="6">
                                    <Image Source="Assets/logo.png" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                                <StackPanel Margin="22,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="AboutTitle" Text="GEN-Z Music for Windows" FontSize="20" FontWeight="Bold" FontFamily="{DynamicResource DisplayFont}" />
                                    <TextBlock Text="Designed &amp; developed by Partho Ghosh · JSL WORKS PVT LTD" Margin="0,4,0,0" FontSize="13" Foreground="{DynamicResource Text2Brush}" />
                                    <TextBlock Text="© 2026 JSL WORKS PVT LTD. All rights reserved." Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource Text2Brush}" />
                                    <TextBlock Text="100% offline · no internet needed · Windows 7 to Windows 11" Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource Text2Brush}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Style="{StaticResource PillButton}" Content="www.jslworks.in" Click="OnWebsite" Margin="0,0,10,0" />
                                        <Button Style="{StaticResource GhostPill}" Content="Updates &amp; downloads" Click="OnUpdates" Margin="0,0,10,0" />
                                        <Button Style="{StaticResource GhostPill}" Content="Terms of use" Click="OnTerms" Margin="0,0,10,0" />
                                        <Button Style="{StaticResource GhostPill}" Content="Licences" Click="OnLicences" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="KEYBOARD" Margin="0,28,0,10" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock FontSize="13" Foreground="{DynamicResource Text2Brush}" TextWrapping="Wrap" LineHeight="22"
                                   Text="Space – play / pause · Ctrl+→ / Ctrl+← – next / previous · Ctrl+F – search · media keys work even when GEN-Z is in the background · taskbar thumbnail buttons control playback." />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- now playing panel -->
            <Border Grid.Column="2" x:Name="NpPanel" Background="{DynamicResource NpBrush}">
                <Grid Margin="28,26,28,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="NpCoverHost" Height="300" Width="300" HorizontalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="OnCoverClick" MouseRightButtonUp="OnCoverMenu">
                        <Border x:Name="NpGlow" CornerRadius="26" Margin="10,18,10,-6" Background="{DynamicResource AccentBrush}" Opacity="0.55">
                            <Border.Effect><BlurEffect Radius="38" /></Border.Effect>
                        </Border>
                        <Border x:Name="NpCover" CornerRadius="22" Background="{DynamicResource SurfaceBrush}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TransformGroup><ScaleTransform /><TranslateTransform /></TransformGroup>
                            </Border.RenderTransform>
                            <Path x:Name="NpCoverNote" Data="{StaticResource IcNote}" Fill="{DynamicResource AccentBrush}" Width="80" Height="80" Stretch="Uniform" />
                        </Border>
                        <Border x:Name="NpLyrics" CornerRadius="22" Visibility="Collapsed" Background="{Binding Background, ElementName=NpCover}" Cursor="Arrow">
                            <Border CornerRadius="22" Background="#D20A0814">
                                <Grid x:Name="LyricsClip" ClipToBounds="True" Margin="20,16" Background="Transparent" MouseWheel="OnLyricsWheel">
                                    <StackPanel x:Name="LyricsPanel" VerticalAlignment="Top">
                                        <StackPanel.RenderTransform><TranslateTransform /></StackPanel.RenderTransform>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Border>
                    </Grid>
                    <StackPanel x:Name="NpInfo" Grid.Row="1" Margin="0,20,0,0">
                        <Grid>
                            <StackPanel Margin="0,0,92,0">
                                <TextBlock x:Name="NpTitle" Text="Nothing playing" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource NpTextBrush}" FontFamily="{DynamicResource DisplayFont}" />
                                <TextBlock x:Name="NpArtist" Text="Pick a song to start" FontSize="14" Foreground="{DynamicResource NpText2Brush}" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="NpLyricsBtn" Style="{StaticResource IconButton}" Tag="{StaticResource IcLyrics}" Foreground="{DynamicResource NpTextBrush}" Click="OnLyricsToggle" ToolTip="Lyrics (Ctrl+L)" />
                                <Button x:Name="NpFav" Style="{StaticResource IconButton}" Tag="{StaticResource IcHeartOutline}" Foreground="{DynamicResource NpTextBrush}" Click="OnFav" ToolTip="Favourite" />
                            </StackPanel>
                        </Grid>
                        <Border x:Name="NpBadge" HorizontalAlignment="Left" Margin="0,10,0,0" CornerRadius="6" Padding="8,3" Background="#00F5D4" Visibility="Collapsed">
                            <TextBlock x:Name="NpBadgeText" FontSize="11" FontWeight="Bold" Foreground="#101020" />
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="NpControls" Grid.Row="2" Margin="0,12,0,0">
                        <c:SparkleBar x:Name="NpBar" />
                        <Grid Margin="0,2,0,0">
                            <TextBlock x:Name="NpElapsed" Text="0:00" FontSize="12" Foreground="{DynamicResource NpText2Brush}" />
                            <TextBlock x:Name="NpRemain" Text="-0:00" FontSize="12" Foreground="{DynamicResource NpText2Brush}" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition /><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="NpShuffle" Style="{StaticResource IconButton}" Tag="{StaticResource IcShuffle}" Foreground="{DynamicResource NpTextBrush}" Click="OnShuffle" />
                            <Button Grid.Column="1" x:Name="NpPrev" Style="{StaticResource IconButton}" Tag="{StaticResource IcPrev}" Foreground="{DynamicResource NpTextBrush}" Click="OnPrev" Width="48" Height="48" />
                            <Grid Grid.Column="2" Width="76" Height="76">
                                <Ellipse x:Name="NpRing" Stroke="{DynamicResource AccentBrush}" StrokeThickness="3" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform><ScaleTransform /></Ellipse.RenderTransform>
                                </Ellipse>
                                <Button x:Name="NpPlay" Click="OnPlay" Cursor="Hand" Focusable="False" RenderTransformOrigin="0.5,0.5">
                                    <Button.RenderTransform><ScaleTransform /></Button.RenderTransform>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid>
                                                <Ellipse Fill="{DynamicResource HeaderBrush}">
                                                    <Ellipse.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.4" Color="Black" /></Ellipse.Effect>
                                                </Ellipse>
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Path x:Name="NpPlayIcon" Data="{StaticResource IcPlay}" Fill="White" Width="28" Height="28" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform><TransformGroup><ScaleTransform /><RotateTransform /></TransformGroup></Path.RenderTransform>
                                    </Path>
                                </Button>
                            </Grid>
                            <Button Grid.Column="3" x:Name="NpNext" Style="{StaticResource IconButton}" Tag="{StaticResource IcNext}" Foreground="{DynamicResource NpTextBrush}" Click="OnNext" Width="48" Height="48" />
                            <Button Grid.Column="4" x:Name="NpRepeat" Style="{StaticResource IconButton}" Tag="{StaticResource IcRepeat}" Foreground="{DynamicResource NpTextBrush}" Click="OnRepeat" />
                        </Grid>
                        <Grid Margin="6,16,6,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Path Data="{StaticResource IcVolume}" Fill="{DynamicResource NpText2Brush}" Width="18" Height="18" Stretch="Uniform" />
                            <Slider x:Name="NpVolume" Grid.Column="1" Style="{StaticResource ThinSlider}" Minimum="0" Maximum="1" Margin="12,0,0,0" ValueChanged="OnVolume" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ player bar ============ -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="240" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Cursor="Hand" Background="Transparent" MouseLeftButtonUp="OnBarSongClick" ToolTip="Show Now Playing">
                    <Border x:Name="BarCover" Width="60" Height="60" CornerRadius="10" Background="{DynamicResource BgBrush}" />
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center" Width="210">
                        <TextBlock x:Name="BarTitle" Text="GEN-Z Music" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock x:Name="BarArtist" Text="Made for music lovers" FontSize="12" Foreground="{DynamicResource Text2Brush}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="620">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="BarPrev" Style="{StaticResource IconButton}" Tag="{StaticResource IcPrev}" Click="OnPrev" />
                        <Button x:Name="BarPlay" Style="{StaticResource IconButton}" Tag="{StaticResource IcPlay}" Click="OnPlay" Width="46" Height="46" Margin="10,0" Foreground="{DynamicResource AccentBrush}" />
                        <Button x:Name="BarNext" Style="{StaticResource IconButton}" Tag="{StaticResource IcNext}" Click="OnNext" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition /><ColumnDefinition Width="46" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="BarElapsed" Text="0:00" FontSize="11" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" />
                        <c:SparkleBar x:Name="BarBar" Grid.Column="1" BarHeight="4" Height="18" />
                        <TextBlock x:Name="BarTotal" Grid.Column="2" Text="0:00" FontSize="11" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
                <StackPanel x:Name="BarVolumeBox" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BarNpBtn" Style="{StaticResource IconButton}" Tag="{StaticResource IcPanel}" Click="OnTogglePanel" ToolTip="Show Now Playing" Margin="0,0,10,0" />
                    <Path Data="{StaticResource IcVolume}" Fill="{DynamicResource Text2Brush}" Width="18" Height="18" Stretch="Uniform" />
                    <Slider x:Name="BarVolume" Style="{StaticResource ThinSlider}" Width="140" Minimum="0" Maximum="1" Margin="12,0,0,0" ValueChanged="OnVolume" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ made in india ============ -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" Padding="0,5,0,6">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <c:Tricolor Margin="0,0,8,0" />
                <TextBlock Text="Made in India with" FontSize="11" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" />
                <TextBlock x:Name="Heart" Text="♥" FontSize="14" Foreground="#E53950" Margin="5,0,0,1" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.55">
                    <TextBlock.RenderTransform><ScaleTransform /></TextBlock.RenderTransform>
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever" Duration="0:0:1.15">
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                                        <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.115" Value="1.35" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.25" Value="0.95" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.37" Value="1.22" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.53" Value="1" />
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                                        <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.115" Value="1.35" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.25" Value="0.95" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.37" Value="1.22" />
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.53" Value="1" />
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>
                <TextBlock Text="  ·  © 2026 JSL WORKS PVT LTD · www.jslworks.in" FontSize="11" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
        <!-- toast -->
        <Border x:Name="Toast" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18" CornerRadius="16" Padding="18,9"
                Background="{DynamicResource RowHlBrush}" Visibility="Collapsed" IsHitTestVisible="False">
            <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.4" /></Border.Effect>
            <TextBlock x:Name="ToastText" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource RowHlTextBrush}" />
        </Border>
    </Grid>
</Window>
