<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:tag="skin_bg">

    <include layout="@layout/view_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:tag="skin_text"
                    android:text="Equalizer"
                    android:textSize="@dimen/text_18"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/eqEnable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="skin_switch" />
            </LinearLayout>

            <TextView
                android:id="@+id/eqInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:tag="skin_text2"
                android:textSize="@dimen/text_12" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/eqPresets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="false"
                    app:singleLine="true"
                    app:singleSelection="true" />
            </HorizontalScrollView>

            <!-- graphical EQ: smooth response curve drawn over the band faders -->
            <FrameLayout
                android:id="@+id/eqGraph"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginTop="12dp"
                android:tag="skin_surface_round">

                <com.jslw.genz.ui.views.EqCurveView
                    android:id="@+id/eqCurve"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:id="@+id/eqBands"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/eqSave"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:tag="skin_button_tonal"
                    android:text="Save preset" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/eqDelete"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:tag="skin_button_tonal"
                    android:text="Delete" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/eqReset"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:tag="skin_button_tonal"
                    android:text="Flat" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:tag="skin_text"
                android:text="Bass boost"
                android:textSize="@dimen/text_15" />

            <com.google.android.material.slider.Slider
                android:id="@+id/eqBass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:tag="skin_slider"
                android:valueFrom="0"
                android:valueTo="1000"
                app:labelBehavior="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="skin_text"
                android:text="3D surround (virtualizer)"
                android:textSize="@dimen/text_15" />

            <com.google.android.material.slider.Slider
                android:id="@+id/eqVirt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:tag="skin_slider"
                android:valueFrom="0"
                android:valueTo="1000"
                app:labelBehavior="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="skin_text"
                android:text="Loudness / volume boost"
                android:textSize="@dimen/text_15" />

            <com.google.android.material.slider.Slider
                android:id="@+id/eqLoud"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:tag="skin_slider"
                android:valueFrom="0"
                android:valueTo="1000"
                app:labelBehavior="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:tag="skin_text"
                android:text="Reverb"
                android:textSize="@dimen/text_15" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/eqReverb"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/eqNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:tag="skin_text2"
                android:textSize="@dimen/text_12" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
