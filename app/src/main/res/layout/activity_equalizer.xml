<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:tag="skin_bg">

    <include layout="@layout/view_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/eqTitleIcon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@null"
                    android:padding="9dp"
                    android:src="@drawable/ic_equalizer" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:tag="skin_text"
                    android:text="Equalizer"
                    android:textSize="@dimen/text_18"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/eqEnable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="skin_switch" />
            </LinearLayout>

            <TextView
                android:id="@+id/eqInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:tag="skin_text2"
                android:textSize="@dimen/text_12" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/eqPresets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="false"
                    app:singleLine="true"
                    app:singleSelection="true" />
            </HorizontalScrollView>

            <!-- graphical EQ: smooth response curve drawn over the band faders -->
            <FrameLayout
                android:id="@+id/eqGraph"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginTop="12dp"
                android:tag="skin_surface_round">

                <com.jslw.genz.ui.views.EqCurveView
                    android:id="@+id/eqCurve"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:id="@+id/eqBands"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/eqGuideLow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawablePadding="6dp"
                    android:gravity="start|center_vertical"
                    android:tag="skin_text2"
                    android:text="Bass"
                    android:textSize="@dimen/text_12" />

                <TextView
                    android:id="@+id/eqGuideMid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawablePadding="6dp"
                    android:gravity="center|center_vertical"
                    android:tag="skin_text2"
                    android:text="Mids · Vocals"
                    android:textSize="@dimen/text_12" />

                <TextView
                    android:id="@+id/eqGuideHigh"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawablePadding="6dp"
                    android:gravity="end|center_vertical"
                    android:tag="skin_text2"
                    android:text="Treble · Air"
                    android:textSize="@dimen/text_12" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/eqSave"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:tag="skin_button_tonal"
                    android:text="Save preset" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/eqDelete"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:tag="skin_button_tonal"
                    android:text="Delete" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/eqReset"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:tag="skin_button_tonal"
                    android:text="Flat" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="2dp"
                android:tag="skin_surface_round">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/eqBassIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@null"
                        android:padding="9dp"
                        android:src="@drawable/ic_eq_bass" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:tag="skin_text"
                            android:text="Bass boost"
                            android:textSize="@dimen/text_15"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:tag="skin_text2"
                            android:text="Deeper, punchier low end"
                            android:textSize="@dimen/text_12" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/eqBassVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:tag="skin_accent_text"
                        android:text="0%"
                        android:textSize="@dimen/text_15"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/eqBass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:tag="skin_slider"
                    android:valueFrom="0"
                    android:valueTo="1000"
                    app:labelBehavior="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="2dp"
                android:tag="skin_surface_round">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/eqVirtIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@null"
                        android:padding="9dp"
                        android:src="@drawable/ic_eq_surround" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:tag="skin_text"
                            android:text="3D surround"
                            android:textSize="@dimen/text_15"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:tag="skin_text2"
                            android:text="Wider stereo – best on headphones"
                            android:textSize="@dimen/text_12" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/eqVirtVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:tag="skin_accent_text"
                        android:text="0%"
                        android:textSize="@dimen/text_15"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/eqVirt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:tag="skin_slider"
                    android:valueFrom="0"
                    android:valueTo="1000"
                    app:labelBehavior="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="2dp"
                android:tag="skin_surface_round">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/eqLoudIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@null"
                        android:padding="9dp"
                        android:src="@drawable/ic_eq_loudness" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:tag="skin_text"
                            android:text="Loudness"
                            android:textSize="@dimen/text_15"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:tag="skin_text2"
                            android:text="Lifts quiet songs and details"
                            android:textSize="@dimen/text_12" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/eqLoudVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:tag="skin_accent_text"
                        android:text="0%"
                        android:textSize="@dimen/text_15"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/eqLoud"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:tag="skin_slider"
                    android:valueFrom="0"
                    android:valueTo="1000"
                    app:labelBehavior="gone" />
            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/eqReverbIcon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@null"
                    android:padding="9dp"
                    android:src="@drawable/ic_eq_reverb" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:tag="skin_text"
                        android:text="Reverb"
                        android:textSize="@dimen/text_15"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:tag="skin_text2"
                        android:text="Put your music in a room, a hall or on a studio plate"
                        android:textSize="@dimen/text_12" />
                </LinearLayout>
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/eqReverb"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/eqNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:tag="skin_text2"
                android:textSize="@dimen/text_12" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
