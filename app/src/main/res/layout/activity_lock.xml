<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/lockRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- soft, blurred-looking album art background -->
    <ImageView
        android:id="@+id/lockBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000" />

    <LinearLayout
        android:id="@+id/lockContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/np_side"
        android:paddingTop="48dp"
        android:paddingEnd="@dimen/np_side"
        android:paddingBottom="28dp">

        <TextClock
            android:id="@+id/lockClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:textColor="#FFFFFFFF"
            android:textSize="64sp" />

        <TextClock
            android:id="@+id/lockDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EEEE, d MMMM"
            android:format24Hour="EEEE, d MMMM"
            android:textColor="#CCFFFFFF"
            android:textSize="@dimen/text_16" />

        <com.jslw.genz.ui.views.ChargingDoodleView
            android:id="@+id/lockCharging"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="gone" />

        <com.jslw.genz.ui.views.SquareFrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="20dp"
            android:layout_weight="1"
            android:padding="12dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/lockArt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeRoundedLarge" />

            <com.jslw.genz.ui.views.CoverEffectView
                android:id="@+id/lockCoverFx"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </com.jslw.genz.ui.views.SquareFrameLayout>

        <TextView
            android:id="@+id/lockTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:gravity="center"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:textSize="@dimen/text_22"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lockArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#CCFFFFFF"
            android:textSize="@dimen/text_15" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/lockProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:max="1000"
            app:indicatorColor="#FFFFFFFF"
            app:trackColor="#40FFFFFF"
            app:trackCornerRadius="2dp"
            app:trackThickness="3dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/lockPrev"
                android:layout_width="@dimen/np_btn"
                android:layout_height="@dimen/np_btn"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Previous"
                android:src="@drawable/ic_prev" />

            <FrameLayout
                android:id="@+id/lockPlayWrap"
                android:layout_width="@dimen/play_btn"
                android:layout_height="@dimen/play_btn"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:background="@drawable/lock_play_bg"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/lockPlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Play/Pause"
                    android:scaleType="center"
                    android:src="@drawable/ic_pause_large" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/lockNext"
                android:layout_width="@dimen/np_btn"
                android:layout_height="@dimen/np_btn"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Next"
                android:src="@drawable/ic_next" />
        </LinearLayout>

        <TextView
            android:id="@+id/lockHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="⌃  Swipe up to close"
            android:textColor="#99FFFFFF"
            android:textSize="@dimen/text_13" />
    </LinearLayout>
</FrameLayout>
