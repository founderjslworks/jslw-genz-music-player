<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp"
    android:tag="skin_row">

    <!-- mini preview of the theme: header strip, background, accent, text -->
    <LinearLayout
        android:id="@+id/themePreview"
        android:layout_width="64dp"
        android:layout_height="56dp"
        android:orientation="vertical">

        <View
            android:id="@+id/themeSw1"
            android:layout_width="match_parent"
            android:layout_height="14dp" />

        <LinearLayout
            android:id="@+id/themeSw2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <View
                android:id="@+id/themeSw3"
                android:layout_width="match_parent"
                android:layout_height="6dp" />

            <View
                android:id="@+id/themeSw4"
                android:layout_width="30dp"
                android:layout_height="4dp"
                android:layout_marginTop="5dp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/themeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:tag="skin_text"
            android:textSize="@dimen/text_16"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/themeAuthor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:tag="skin_text2"
            android:textSize="@dimen/text_12" />
    </LinearLayout>

    <ImageView
        android:id="@+id/themeCheck"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="6dp"
        android:contentDescription="Active"
        android:src="@drawable/ic_check"
        android:tag="skin_accent_icon" />

    <ImageButton
        android:id="@+id/themeMenu"
        style="@style/IconButton"
        android:contentDescription="Theme options"
        android:src="@drawable/ic_more" />
</LinearLayout>
