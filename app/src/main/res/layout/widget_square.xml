<?xml version="1.0" encoding="utf-8"?>
<!-- Square 2x2 widget: turntable on top, controls below -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/wBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

        <ImageView
            android:id="@+id/wArt"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:contentDescription="Album art"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/wTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/nothing_playing"
                android:textColor="#FF2B2027"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/tap_to_play"
                android:textColor="#FF85747D"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/wPrev"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@null"
                android:contentDescription="Previous"
                android:padding="0dp"
                android:scaleType="fitCenter" />
            <ImageButton
                android:id="@+id/wPlay"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@null"
                android:contentDescription="Play/Pause"
                android:padding="0dp"
                android:scaleType="fitCenter" />
            <ImageButton
                android:id="@+id/wNext"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@null"
                android:contentDescription="Next"
                android:padding="0dp"
                android:scaleType="fitCenter" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
