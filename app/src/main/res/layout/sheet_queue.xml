<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:tag="skin_surface">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:tag="skin_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="skin_text"
                android:text="Up next"
                android:textSize="@dimen/text_20"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/queueInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="skin_text2"
                android:textSize="@dimen/text_13" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/queueSave"
            style="@style/IconButton"
            android:contentDescription="Save as playlist"
            android:src="@drawable/ic_playlist_add" />

        <ImageButton
            android:id="@+id/queueShuffle"
            style="@style/IconButton"
            android:contentDescription="Shuffle"
            android:src="@drawable/ic_shuffle" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingBottom="4dp"
        android:tag="skin_text2"
        android:text="Drag ≡ to reorder · swipe to remove"
        android:textSize="@dimen/text_11" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/queueList"
        android:layout_width="match_parent"
        android:layout_height="420dp" />
</LinearLayout>
