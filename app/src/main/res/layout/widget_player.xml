<?xml version="1.0" encoding="utf-8"?>
<!-- Wide 4x1 widget: compact turntable pill -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/wBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="14dp">

        <ImageView
            android:id="@+id/wArt"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:contentDescription="Album art"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/wTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="start"
                android:maxLines="1"
                android:text="@string/nothing_playing"
                android:textColor="#FF2B2027"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="start"
                android:maxLines="1"
                android:text="@string/tap_to_play"
                android:textColor="#FF85747D"
                android:textSize="11sp" />
            <Chronometer
                android:id="@+id/wTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:gravity="start"
                android:textColor="#FF3A2E34"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/wPrev"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@null"
            android:contentDescription="Previous"
            android:padding="0dp"
            android:scaleType="fitCenter" />
        <ImageButton
            android:id="@+id/wPlay"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@null"
            android:contentDescription="Play/Pause"
            android:padding="0dp"
            android:scaleType="fitCenter" />
        <ImageButton
            android:id="@+id/wNext"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@null"
            android:contentDescription="Next"
            android:padding="0dp"
            android:scaleType="fitCenter" />
    </LinearLayout>
</FrameLayout>
