<?xml version="1.0" encoding="utf-8"?>
<com.jslw.genz.ui.views.DragDismissLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/npRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/npContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/npArtFrame"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="8dp"
            android:paddingBottom="16dp">

            <com.jslw.genz.ui.views.SquareFrameLayout
                android:id="@+id/npArtSquare"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/npArt"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeRoundedLarge" />
                <com.jslw.genz.ui.views.CoverEffectView
                    android:id="@+id/npCoverFx"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </com.jslw.genz.ui.views.SquareFrameLayout>

            <include layout="@layout/view_np_lyrics" />
        </FrameLayout>

        <!-- right side: title, "playing on", seek bar and controls. Scrolls on short landscape screens so
             nothing is cut off; on taller ones the controls sit at the bottom as usual. -->
        <ScrollView
            android:id="@+id/npSideScroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/npSide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <include layout="@layout/view_np_topbar" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <include layout="@layout/view_np_controls" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- full-screen "love it" celebration; never takes touches -->
    <com.jslw.genz.ui.views.CelebrationView
        android:id="@+id/npCelebrate"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</com.jslw.genz.ui.views.DragDismissLayout>
